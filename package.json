{
  "name": "@suynda/ui",
  "version": "0.2.1",
  "description": "La capa visual de Suynda: tokens, primitivas y fuentes. Se consume por tag de git, igual que @suynda/contracts.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens.css",
    "src/piezas.css",
    "src/iconos.css",
    "iconos",
    "fuentes",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./fuentes/fuentes.css": "./fuentes/fuentes.css",
    "./fuentes/*": "./fuentes/*",
    "./piezas.css": "./src/piezas.css",
    "./iconos.css": "./src/iconos.css",
    "./iconos/*": "./iconos/*"
  },
  "scripts": {
    "generar:tokens": "node scripts/generar-tokens-ts.mjs",
    "prebuild": "node scripts/generar-tokens-ts.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "verify": "npm run build && npm test && npm run compuerta",
    "compuerta": "node scripts/compuerta.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@suynda/contracts": "github:liviojanz/suynda-contracts#v0.9.1"
  },
  "bin": {
    "suynda-ui-compuerta": "./scripts/compuerta.mjs"
  }
}
